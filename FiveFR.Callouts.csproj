<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net472</TargetFramework>
        <LangVersion>12</LangVersion>
        <RootNamespace>FiveFR.Callouts</RootNamespace>
        <AssemblyName>FiveFR.Callouts.net</AssemblyName>
        <OutputType>Library</OutputType>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
        <PackageReference Include="CitizenFX.Core.Client" Version="1.0.26803" ExcludeAssets="runtime" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="FiveFR.API.net">
            <HintPath>..\FiveFR\FiveFR.API\bin\Debug\win-x64\FiveFR.API.net.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="packages\**" />
        <None Remove="packages\**" />
    </ItemGroup>

</Project>
